---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <script is:inline>
      // First paint: the saved palette, so the page never flashes the default.
      // Keep the ids and the old-toggle fallback in step with lib/palettes.ts
      // and loadSettings in app/store.tsx.
      (() => {
        const ids = [
          'pop',
          'mint',
          'blueprint',
          'retro',
          'bubblegum',
          'citrus',
          'newsprint',
          'arcade',
        ];
        let palette = 'pop';
        try {
          const saved = JSON.parse(localStorage.getItem('settings') || '{}');
          if (saved && ids.includes(saved.palette)) palette = saved.palette;
          else if (localStorage.getItem('theme') === 'dark') palette = 'arcade';
        } catch {}
        document.documentElement.dataset.theme = palette;
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
