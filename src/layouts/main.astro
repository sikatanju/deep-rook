---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#ffd23f" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="DeepRook" />
    <title>{title}</title>
    <script is:inline>
      // First paint: the saved palette, so the page never flashes the default.
      // The cookie wins. Local storage is the copy from before that move.
      // Keep the ids and the fallbacks (old toggle, then the OS dark setting)
      // in step with lib/palettes.ts and loadSettings in app/store.tsx.
      (() => {
        const ids = ['pop', 'newsprint', 'arcade'];
        let palette = 'pop';
        try {
          const prefix = 'settings=';
          const fromCookie = document.cookie
            .split(';')
            .map((part) => part.trim())
            .find((part) => part.startsWith(prefix));
          const raw = fromCookie
            ? decodeURIComponent(fromCookie.slice(prefix.length))
            : localStorage.getItem('settings');
          const saved = JSON.parse(raw || '{}');
          if (saved && ids.includes(saved.palette)) palette = saved.palette;
          else if (
            !fromCookie &&
            (localStorage.getItem('theme') === 'dark' ||
              matchMedia('(prefers-color-scheme: dark)').matches)
          )
            palette = 'arcade';
        } catch {}
        document.documentElement.dataset.theme = palette;
      })();
    </script>
    {import.meta.env.PROD && <script is:inline>
      // Production only: in dev it would cache Vite's modules. Offline
      // support is optional, so a refusal (private mode, blocked storage)
      // stays quiet.
      addEventListener('load', () => {
        try {
          navigator.serviceWorker?.register('/sw.js').catch(() => {});
        } catch {}
      });
    </script>}
  </head>
  <body>
    <slot />
  </body>
</html>
