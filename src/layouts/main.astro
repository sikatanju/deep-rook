---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#ffd23f" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="DeepRook" />
    <title>{title}</title>
    <script is:inline>
      // First paint: the saved palette, so the page never flashes the default.
      // Keep the ids and the old-toggle fallback in step with lib/palettes.ts
      // and loadSettings in app/store.tsx.
      (() => {
        const ids = [
          'pop',
          'mint',
          'blueprint',
          'retro',
          'bubblegum',
          'citrus',
          'newsprint',
          'arcade',
        ];
        let palette = 'pop';
        try {
          const saved = JSON.parse(localStorage.getItem('settings') || '{}');
          if (saved && ids.includes(saved.palette)) palette = saved.palette;
          else if (localStorage.getItem('theme') === 'dark') palette = 'arcade';
        } catch {}
        document.documentElement.dataset.theme = palette;
      })();
    </script>
    {import.meta.env.PROD && <script is:inline>
      // Production only: in dev it would cache Vite's modules. Offline
      // support is optional, so a refusal (private mode, blocked storage)
      // stays quiet.
      addEventListener('load', () => {
        try {
          navigator.serviceWorker?.register('/sw.js').catch(() => {});
        } catch {}
      });
    </script>}
  </head>
  <body>
    <slot />
  </body>
</html>
